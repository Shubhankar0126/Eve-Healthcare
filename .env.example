# --- core ---
DATABASE_URL=postgresql+psycopg://eve:eve@localhost:5432/eve
JWT_SECRET=change-me-to-a-long-random-string-of-32+bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
WEBHOOK_SECRET=whsec_dev
LOG_LEVEL=INFO

# --- redis (optional: cache, rate limiting, celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- rate limits (requests / minute / IP) ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
PAYMENT_RATE_LIMIT_PER_MINUTE=30

# --- background jobs ---
PENDING_PAYMENT_TIMEOUT_MINUTES=15
SIMULATE_PROVIDER_CALLBACK=false      # true: mock provider POSTs the webhook itself (needs a worker)
WEBHOOK_TARGET_URL=http://localhost:8000/payments/webhook/

# --- seed ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
